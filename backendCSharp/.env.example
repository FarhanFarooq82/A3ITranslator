# A3I Translator API Configuration
# Copy this file to .env and add your actual API keys

# Azure Speech Services
# Get these from: https://portal.azure.com -> Cognitive Services -> Speech
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus

# OpenAI API
# Get this from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Speech & TTS
# Get this from: https://console.cloud.google.com -> APIs & Services -> Credentials
GOOGLE_CLOUD_PROJECT_ID=your_google_cloud_project_id
GOOGLE_APPLICATION_CREDENTIALS=path/to/google-cloud-credentials.json

# Google Gemini AI
# Get this from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Instructions:
# 1. Copy this file to .env
# 2. Replace all placeholder values with your actual API keys
# 3. For Google Cloud, download the service account JSON file
# 4. Update the GOOGLE_APPLICATION_CREDENTIALS path to point to your JSON file
